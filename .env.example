# انسخ هذا الملف إلى .env واملأ القيم
FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=sqlite:///app.db

# ===== نقطة النهاية الأساسية (متوافقة مع OpenAI) =====
# اترك OPENAI_BASE_URL فارغاً لاستخدام OpenAI الرسمي مباشرة.
# لاستخدام موجّه محلي (FreeLLMAPI):  http://127.0.0.1:31415/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ===== (اختياري) نقطة نهاية احتياطية — تفعيل الفشل التلقائي =====
# تُفعَّل فقط عند ملء AI_FALLBACK_API_KEY. اتركها فارغة لتعطيلها.
# مثال: قاعدة رسمية احتياطية عند تعطّل الموجّه المحلي:
#   AI_FALLBACK_BASE_URL=
#   AI_FALLBACK_API_KEY=sk-...
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=

# ===== النماذج =====
# الأساسية (تطابق نقطة النهاية الأساسية)
AI_MODEL_MAIN=gemini-flash-lite
AI_MODEL_FAST=gemini-flash-lite
# الاحتياطية (تطابق نقطة النهاية الاحتياطية)
AI_FALLBACK_MODEL_MAIN=gpt-5.6-terra
AI_FALLBACK_MODEL_FAST=gpt-5.6-luna

AI_TIMEOUT=20
AI_MAX_RETRIES=1
LOG_LEVEL=INFO
